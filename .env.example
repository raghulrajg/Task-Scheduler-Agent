# Copy to .env on each machine and fill in real values. NEVER commit .env.
# Use a different MQTT user per machine role (scheduler / agent / reasoning)
# so the broker ACL can limit what each one may publish (deploy/mosquitto/).

MQTT_BROKER_HOST=192.168.12.10
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=1
MQTT_TLS_CA_CERT=/etc/robot-fleet/ca.crt

ROBOT_METADATA_PATH=robots_metadata.json
SITE_CONFIG_PATH=site.json
SCHEDULER_STATE_PATH=state/scheduler_state.json
REQUIRE_HEARTBEAT=1

INSTRUCTION_TOPIC=scheduler/instructions
COMMAND_TOPIC=scheduler/commands
EVENT_TOPIC=scheduler/events
FLEET_STATUS_TOPIC=scheduler/status
HMI_PROMPT_TOPIC=hmi/user_prompt
HMI_FEEDBACK_TOPIC=hmi/feedback
HMI_CONFIRM_TOPIC=hmi/confirm

# Reasoning agent
OLLAMA_HOST=192.168.12.11
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3:8b
REQUIRE_CONFIRMATION=1

# Vendor credentials referenced as ${...} from agents/*.json (robot agent hosts only)
MIR_USERNAME=
MIR_PASSWORD=
