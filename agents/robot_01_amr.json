{
  "_comment": "Mobile base of robot_01, driven through its own web dashboard API. EVERYTHING under navigate/cancel/status/fields/login is a PLACEHOLDER until the capture is done (docs/AMR_API_CAPTURE.md). Run: python3 tools/har_summary.py capture.har, then fill this in.",
  "robot_id": "robot_01",
  "subsystem": "amr",
  "heartbeat_s": 5,
  "interlock_with": ["arm"],
  "require_travel_pose": ["arm"],
  "driver": {
    "type": "http_amr",
    "base_url": "http://ROBOT-IP",
    "headers": {"Content-Type": "application/json"},
    "login": {
      "method": "POST",
      "path": "/REPLACE/login",
      "json": {"username": "${AMR_USERNAME}", "password": "${AMR_PASSWORD}"},
      "token_path": "REPLACE.token",
      "token_header": "Authorization",
      "token_prefix": "Bearer "
    },
    "locations": {
      "manufacturing_1": {"id": "REPLACE-drop-point-name-or-id"},
      "quality_station": {"id": "REPLACE"},
      "package_area":    {"id": "REPLACE"},
      "waste_area":      {"id": "REPLACE"},
      "rest_position":   {"id": "REPLACE"}
    },
    "navigate": {"method": "POST", "path": "/REPLACE/goto", "json": {"REPLACE_point_key": "{id}"}},
    "cancel":   {"method": "POST", "path": "/REPLACE/cancel"},
    "status":   {"method": "GET",  "path": "/REPLACE/status"},
    "fields": {
      "nav_state": "REPLACE.path.to.navigation.state",
      "running_values": ["REPLACE"],
      "arrived_values": ["REPLACE"],
      "failed_values":  ["REPLACE"],
      "target": null,
      "battery": null,
      "battery_scale": 1,
      "estop": null,
      "estop_values": [true],
      "error": null
    },
    "poll_interval_s": 0.5,
    "settle_s": 3,
    "start_timeout_s": 15,
    "mission_timeout_s": 280,
    "max_comm_loss_s": 30,
    "request_timeout_s": 5
  }
}
