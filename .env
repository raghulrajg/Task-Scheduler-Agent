# Copy to .env in the project folder on EVERY machine (central server and
# robot PC) and fill in real values. NEVER commit .env (it is in .gitignore).
# The same .env serves both modes: TEST mode isolates itself automatically
# (topics under "sim/", client ids ending in "-test", its own state file).

# ---- EMQX broker -------------------------------------------------------------------
MQTT_BROKER_HOST=172.25.200.57
MQTT_BROKER_PORT=1883
MQTT_USERNAME=raghulrajg
MQTT_PASSWORD=Gr2_nemam
# 1883 is EMQX's plain listener. For encryption use EMQX's SSL listener (8883),
# set MQTT_TLS=1 and point MQTT_TLS_CA_CERT at the CA certificate.
MQTT_TLS=0
# MQTT_TLS_CA_CERT=/etc/robot-fleet/ca.crt

# ---- Reasoning agent (Ollama) --------------------------------------------------------
OLLAMA_HOST=172.16.13.90
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3:8b
# 1 = an operator must confirm each parsed instruction on hmi/confirm before robots move
REQUIRE_CONFIRMATION=1

# ---- Robot PC only: credentials referenced as ${...} from agents/*.json -----------------
# Mobile robot web dashboard login (only if its API needs one)
AMR_USERNAME=
AMR_PASSWORD=

# ---- Rarely changed (defaults shown) -----------------------------------------------------
# ROBOT_METADATA_PATH=robots_metadata.json
# SITE_CONFIG_PATH=site.json
# REQUIRE_HEARTBEAT=1
# MQTT_TOPIC_PREFIX=            # real mode: topics at the root (test mode uses "sim/")
# LOG_LEVEL=INFO
