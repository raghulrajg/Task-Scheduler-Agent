# systemd unit for reasoning_agent.py (Ollama prompt -> validated instruction).
[Unit]
Description=Reasoning agent (natural language -> scheduler instruction)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fleet
WorkingDirectory=/opt/robot-fleet
EnvironmentFile=/opt/robot-fleet/.env
ExecStart=/opt/robot-fleet/venv/bin/python reasoning_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
